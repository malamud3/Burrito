}
.ct-tool.active-tool {
    border-color: #a7b9a1;
    box-shadow: 0 0 0 3px rgba(85, 116, 94, 0.09), var(--shadow);
}
.ct-tool.difficulty-detected {
    border-color: #e7aaaa;
    box-shadow: 0 0 0 3px rgba(215, 0, 21, 0.06);
}
.ct-tool-header { margin-bottom: 14px; }
.ct-tool-title { gap: 11px; }
.ct-icon {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--surface3);
}
.ct-icon.decomp { background: #eeeaf1; color: #756682; }
.ct-icon.abstract { background: #e7eef0; color: #466879; }
.ct-icon.algo { background: #f1e8dc; color: #8a603e; }
.ct-status { padding: 4px 10px; border-radius: 99px; }
.status-waiting { background: #f2f2f5; color: #6e6e73; }
.status-working { background: #e6ede3; color: #405e49; }
.status-done { background: #e5eee4; color: #405e49; }
.status-struggle { background: #f4e7e2; color: #91483f; }

textarea, input[type="text"], input[type="number"], select {
    min-height: 44px;
    border: 1px solid #d5d0c4;
    border-radius: 10px;
    background-color: #f8f6ef;
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
}
textarea { min-height: 104px; line-height: 1.75; }
textarea, input[type="text"] { unicode-bidi: plaintext; text-align: start; }
textarea::placeholder, input::placeholder { color: #77756c; opacity: 1; }
textarea:focus, input:focus, select:focus {
    outline: none;
    border-color: #829b83;
    background-color: #fbf9f3;
    box-shadow: 0 0 0 3px rgba(85, 116, 94, 0.12);
}
label { margin-bottom: 7px; color: #494840; font-size: 0.9rem; font-weight: 600; line-height: 1.45; }
.field { margin-bottom: 18px; }

.btn {
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 10px;
    font-size: 0.92rem;
    transition: background var(--transition), border-color var(--transition), color var(--transition), transform var(--transition), box-shadow var(--transition);
}
.btn-primary, .btn-success {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 2px 6px rgba(68, 96, 74, 0.16);
}
.btn-primary:hover, .btn-success:hover { background: var(--primary-dim); transform: translateY(-1px); }
.btn-outline {
    border: 1px solid #d5d0c4;
    background: #f8f6ef;
    color: #494840;
}
.btn-outline:hover { border-color: #a7b9a1; background: #eef2e9; color: #405e49; }
.btn:focus-visible, .effort-btn:focus-visible, .tab:focus-visible, .remove-step:focus-visible {
    outline: 3px solid rgba(85, 116, 94, 0.3);
    outline-offset: 2px;
}
.btn:disabled { background: #e9e6dd; color: #77756c; border-color: #e9e6dd; box-shadow: none; }
.btn-group { gap: 10px; }

.step-item {
    align-items: center;
    padding: 10px;
    border: 1px solid #e5e0d5;
    border-radius: 11px;
    background: #f8f6ef;
}
.step-item:hover { border-color: #d3ddce; }
.step-number { background: #e6ede3; color: #405e49; }
.remove-step { color: #91483f; }

.abstraction-table { border-spacing: 0; border-collapse: separate; overflow: hidden; border-radius: 11px; }
.abstraction-table { table-layout: fixed; }
.abstraction-table th, .abstraction-table td { border-color: #e2ded3; }
.abstraction-table th { background: #efede5; color: #514f47; }
.abstraction-table td { background: #f9f7f0; overflow-wrap: anywhere; }
.abstraction-table td input { min-height: 38px; }
.abstraction-table td select { min-height: 38px; }
.flow-node {
    width: min(100%, 360px);
    border: 1px solid #d5d0c4;
    border-radius: 11px;
    background: #f8f6ef;
}
.flow-arrow { color: #8a8a90; }

.hint-box.visible {
    border-color: #d4dfd1;
    border-radius: 13px;
    background: #edf2e9;
}
.hint-box .hint-level { color: #405e49; letter-spacing: 0.01em; }
.hint-box p { color: #45483f; line-height: 1.8; }
.analog-banner {
    padding: 24px;

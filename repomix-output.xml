.dashboard-screen > .card { margin-top: 16px; }
.assessment-scoring h2 { margin-bottom: 8px; }
.assessment-rubric-anchors { margin: 12px 0 20px; padding-inline-start: 22px; }
.assessment-scoring-meta {

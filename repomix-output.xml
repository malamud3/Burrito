import React, { useCallback, useEffect } from 'react';
import { useSessionContext } from '../../context/SessionContext';
import { useLogger } from '../../hooks/useLogger';
import { CTSkill, LogActionType } from '../../core/types/enums';
import { MAIN_PROBLEM } from '../../core/constants/problems';
import CTToolWrapper from './CTToolWrapper';

export default function AbstractionTool({ status }) {
  const { session, updateAbstractionRows } = useSessionContext();
  const { log } = useLogger();
  const rows = session.toolState.abstraction.rows;

  // Seed rows from the problem definition the first time the tool mounts.
  useEffect(() => {
    if (rows.length === 0) {
      updateAbstractionRows(
        MAIN_PROBLEM.abstractionData.map((item, i) => ({
          id: `abs_${i}`,
          datum: item.datum,
          actualRelevant: item.relevant,
          actualRole: item.role,
          userRelevant: undefined,
          userRole: '',
        })),
      );
    }
  }, []); // eslint-disable-line react-hooks/exhaustive-deps

  const patchRow = useCallback(
    (rowId, patch, field, value) => {
      updateAbstractionRows(rows.map((r) => (r.id === rowId ? { ...r, ...patch } : r)));
      log(LogActionType.EDIT, { rowId, field, value }, CTSkill.ABSTRACTION);
    },
    [rows, updateAbstractionRows, log],
  );

  const handleRelevanceChange = (rowId, raw) => {
    if (raw === '') {
      patchRow(rowId, { userRelevant: undefined }, 'relevant', null);
      return;
    }
    const value = raw === 'כן';
    patchRow(rowId, { userRelevant: value }, 'relevant', value);
  };

  const handleRoleChange = (rowId, value) =>
    patchRow(rowId, { userRole: value }, 'role', value);

  const selectValue = (row) =>
    row.userRelevant === undefined ? '' : row.userRelevant ? 'כן' : 'לא';

  return (
    <CTToolWrapper skill={CTSkill.ABSTRACTION} status={status}>
      <table className="abstraction-table">
        <thead>
          <tr>
            <th style={{ width: '40%' }}>נתון / מידע</th>
            <th style={{ width: '25%' }}>רלוונטי?</th>
            <th style={{ width: '35%' }}>תפקיד בפתרון</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr key={row.id}>
              <td style={{ color: 'var(--text)', fontSize: '0.9rem' }}>{row.datum}</td>
              <td>
                <select
                  value={selectValue(row)}
                  onChange={(e) => handleRelevanceChange(row.id, e.target.value)}
                  style={{ fontSize: '0.85rem', padding: '6px 8px' }}
                >
                  <option value="">—</option>
                  <option value="כן">כן</option>
                  <option value="לא">לא</option>
                </select>
              </td>
              <td>
                <input
                  type="text"
                  value={row.userRole}
                  placeholder="תפקיד..."
                  onChange={(e) => handleRoleChange(row.id, e.target.value)}
                  style={{ fontSize: '0.85rem' }}
                />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </CTToolWrapper>
  );
}
</file>

<file path="src/components/ct-tools/AlgorithmTool.jsx">
import React, { useCallback } from 'react';
import { useSessionContext } from '../../context/SessionContext';
import { useLogger } from '../../hooks/useLogger';
import { CTSkill, LogActionType } from '../../core/types/enums';
import { generateId } from '../../core/utils/idGenerator';
import CTToolWrapper from './CTToolWrapper';

export default function AlgorithmTool({ status }) {
  const { session, updateAlgoNodes } = useSessionContext();
  const { log } = useLogger();
  const nodes = session.toolState.algorithmic.nodes;

  const handleNodeChange = useCallback(
    (nodeId, value) => {
      updateAlgoNodes(nodes.map((n) => (n.id === nodeId ? { ...n, value } : n)));
      log(LogActionType.EDIT, { nodeId, value }, CTSkill.ALGORITHMIC);
    },
    [nodes, updateAlgoNodes, log],
  );

  const addNode = useCallback(() => {
    const newNode = {
      id: generateId('node'),
      value: '',
      placeholder: `פעולה ${nodes.length - 1}...`,
    };
    // Keep the final node (result) last.
    const updated = [...nodes.slice(0, -1), newNode, nodes[nodes.length - 1]];
    updateAlgoNodes(updated);
    log(
      LogActionType.FLOW_NODE_ADD,
      { nodeId: newNode.id, totalNodes: updated.length },
      CTSkill.ALGORITHMIC,
    );
  }, [nodes, updateAlgoNodes, log]);

  const removeNode = useCallback(
    (nodeId) => {
      if (nodes.length <= 2) return;
      const updated = nodes.filter((n) => n.id !== nodeId);
      updateAlgoNodes(updated);
      log(
        LogActionType.STEP_REMOVE,
        { nodeId, totalNodes: updated.length },
        CTSkill.ALGORITHMIC,
      );
    },
    [nodes, updateAlgoNodes, log],
  );

  return (
    <CTToolWrapper skill={CTSkill.ALGORITHMIC} status={status}>
      <div className="flow-builder">
        {nodes.map((node, index) => {
          const isMiddle = index > 0 && index < nodes.length - 1;
          return (
            <React.Fragment key={node.id}>
              <div className="flow-node" style={{ position: 'relative' }}>
                <input
                  type="text"
                  value={node.value}
                  placeholder={node.placeholder}
                  onChange={(e) => handleNodeChange(node.id, e.target.value)}
                />
                {isMiddle && (
                  <button
                    className="remove-step"
                    onClick={() => removeNode(node.id)}
                    style={{
                      position: 'absolute',
                      left: -30,
                      top: '50%',
                      transform: 'translateY(-50%)',
                    }}
                    title="הסר שלב"
                    aria-label={`הסר צומת ${index + 1}`}
                  >
                    ✕
                  </button>
                )}
              </div>
              {index < nodes.length - 1 && <div className="flow-arrow">↓</div>}
            </React.Fragment>
          );
        })}
      </div>

      <button
        className="btn btn-outline btn-sm"
        onClick={addNode}
        style={{ marginTop: 12 }}
      >
        + הוסף שלב בתרשים
      </button>
    </CTToolWrapper>
  );
}
</file>

<file path="src/components/ct-tools/CTToolWrapper.jsx">
import React from 'react';
import { CT_SKILL_CONFIG } from '../../core/constants/ctSkills';
import { ToolStatus } from '../../core/types/enums';

const STATUS_CONFIG = {
  [ToolStatus.WAITING]: { label: 'ממתין', className: 'status-waiting' },
  [ToolStatus.WORKING]: { label: 'בעבודה', className: 'status-working' },
  [ToolStatus.DONE]: { label: 'הושלם', className: 'status-done' },
  [ToolStatus.STRUGGLE]: { label: 'קושי אפשרי', className: 'status-struggle' },
};

/**
 * Open/Closed: wraps any CT tool with consistent chrome
 * (header, status badge, instructions).
 */
export default function CTToolWrapper({
  skill,
  status = ToolStatus.WAITING,
  children,
}) {
  const config = CT_SKILL_CONFIG[skill];
  const statusConfig = STATUS_CONFIG[status];
  if (!config) return null;

  const isStruggle = status === ToolStatus.STRUGGLE;
  const isWorking = status === ToolStatus.WORKING;

  return (
    <div
      className={`ct-tool ${isWorking ? 'active-tool' : ''} ${
        isStruggle ? 'difficulty-detected pulse' : ''
      }`}
    >
      <div className="ct-tool-header">
        <div className="ct-tool-title">
          <div className={`ct-icon ${config.colorClass}`}>{config.icon}</div>
          <span>{config.description}</span>
        </div>
        <span className={`ct-status ${statusConfig.className}`}>
          {statusConfig.label}
        </span>
      </div>
      <p style={{ fontSize: '0.85rem', color: 'var(--text2)', marginBottom: 12 }}>
        {config.instructions}
      </p>
      {children}
    </div>
  );
}
</file>

<file path="src/components/ct-tools/DecompositionTool.jsx">
import React, { useCallback } from 'react';
import { useSessionContext } from '../../context/SessionContext';
import { useLogger } from '../../hooks/useLogger';
import { CTSkill, LogActionType } from '../../core/types/enums';
import { generateStepId } from '../../core/utils/idGenerator';
import CTToolWrapper from './CTToolWrapper';

export default function DecompositionTool({ status }) {
  const { session, updateDecompSteps } = useSessionContext();
  const { log } = useLogger();
  const steps = session.toolState.decomposition.steps;

  const handleStepChange = useCallback(
    (stepId, value) => {
      updateDecompSteps(steps.map((s) => (s.id === stepId ? { ...s, value } : s)));
      log(LogActionType.EDIT, { stepId, value }, CTSkill.DECOMPOSITION);
    },
    [steps, updateDecompSteps, log],
  );

  const addStep = useCallback(() => {
    const newStep = { id: generateStepId(), value: '' };
    const updated = [...steps, newStep];
    updateDecompSteps(updated);
    log(
      LogActionType.STEP_ADD,
      { stepId: newStep.id, totalSteps: updated.length },
      CTSkill.DECOMPOSITION,
    );
  }, [steps, updateDecompSteps, log]);

  const removeStep = useCallback(
    (stepId) => {
      if (steps.length <= 1) return;
      const updated = steps.filter((s) => s.id !== stepId);
      updateDecompSteps(updated);
      log(
        LogActionType.STEP_REMOVE,
        { stepId, totalSteps: updated.length },
        CTSkill.DECOMPOSITION,
      );
    },
    [steps, updateDecompSteps, log],
  );

  return (
    <CTToolWrapper skill={CTSkill.DECOMPOSITION} status={status}>
      <div className="step-list">
        {steps.map((step, index) => (
          <div className="step-item" key={step.id}>
            <div className="step-number">{index + 1}</div>
            <div className="step-input">
              <input
                type="text"
                value={step.value}
                placeholder={`שלב ${index + 1}...`}
                onChange={(e) => handleStepChange(step.id, e.target.value)}
              />
            </div>
            {steps.length > 1 && (
              <button
                className="remove-step"
                onClick={() => removeStep(step.id)}
                title="הסר שלב"
                aria-label={`הסר שלב ${index + 1}`}
              >
                ✕
              </button>
            )}
          </div>
        ))}
      </div>

      <button
        className="btn btn-outline btn-sm"
        onClick={addStep}
        style={{ marginTop: 8 }}
      >
        + הוסף שלב
      </button>
    </CTToolWrapper>
  );
}
</file>


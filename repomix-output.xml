// Derives each CT tool's status from the log trace.
// ============================================================

import { useMemo } from 'react';
import { useLogContext } from '../context/LogContext';
import { CTSkill, ToolStatus } from '../core/types/enums';

export function useToolStatuses(struggleSkill = null) {
  const { logs } = useLogContext();

  return useMemo(
    () =>
      Object.values(CTSkill).reduce((acc, skill) => {
        if (skill === struggleSkill) acc[skill] = ToolStatus.STRUGGLE;
        else if (logs.some((l) => l.skill === skill)) acc[skill] = ToolStatus.WORKING;
        else acc[skill] = ToolStatus.WAITING;
        return acc;
      }, {}),
    [logs, struggleSkill],
  );
}
</file>

<file path="src/services/AnalogTaskSelector.js">
// ============================================================
// src/services/AnalogTaskSelector.js
// Single Responsibility: choose the analog support task.
// Strategy Pattern: one strategy per research group.
// ============================================================

import { Group, CTSkill } from '../core/types/enums';
import { ANALOG_PROBLEMS } from '../core/constants/problems';

const selectionStrategies = {
  /** Adaptive: the task matching the detected difficulty. */
  [Group.ADAPTIVE]: (detectedSkill) =>
    ANALOG_PROBLEMS[detectedSkill] || ANALOG_PROBLEMS[CTSkill.DECOMPOSITION],

  /** Fixed: a predetermined task, independent of detection. */
  [Group.FIXED]: (_detectedSkill, sessionIndex = 0) => {
    const skills = Object.keys(ANALOG_PROBLEMS);
    return ANALOG_PROBLEMS[skills[sessionIndex % skills.length]];
  },
};

export function selectAnalogTask(group, detectedSkill, sessionIndex = 0) {
  const strategy = selectionStrategies[group];
  if (!strategy) throw new Error(`Unknown group: ${group}`);

  const task = strategy(detectedSkill, sessionIndex);

  return {
    ...task,
    selectedBy: group === Group.ADAPTIVE ? 'adaptive' : 'fixed',
    matchesDetectedSkill: task.id === ANALOG_PROBLEMS[detectedSkill]?.id,
  };
}

export function registerSelectionStrategy(group, strategy) {
  selectionStrategies[group] = strategy;
}
</file>

<file path="src/services/AssessmentScoringService.js">
import { FUNCTION_ASSESSMENT_QUESTIONS } from '../core/constants/functionAssessments';
import {
  ASSESSMENT_RUBRIC_VERSION,
  ASSESSMENT_SCORE_MAX,
} from '../core/constants/assessmentRubric';
import { LogActionType } from '../core/types/enums';

const SUBMISSION_TYPES = Object.freeze({
  [LogActionType.PRE_ASSESSMENT_SUBMIT]: 'preAssessment',
  [LogActionType.TRANSFER_SUBMIT]: 'transferAssessment',
});

const ASSESSMENT_LABELS = Object.freeze({
  preAssessment: 'בוחן מקדים',
  transferAssessment: 'בוחן העברה',
});

const recordKey = (sessionId, assessmentType) => `${sessionId}:${assessmentType}`;

function normalizeScore(value) {
  return Number.isInteger(value) && value >= 0 && value <= 2 ? value : '';
}

export function calculateAssessmentScore(scores) {
  return Object.values(scores).reduce(
    (total, score) => total + (Number.isInteger(score) && score >= 0 && score <= 2 ? score : 0),
    0,
  );
}

export function getAssessmentScoringRecords(logs) {
  const submissions = new Map();
  const savedScores = new Map();

  logs.forEach((entry) => {
    const sessionId = entry.data?.sessionId;
    if (!sessionId) return;

    const assessmentType = SUBMISSION_TYPES[entry.actionType];
    if (assessmentType && entry.data?.assessment) {
      submissions.set(recordKey(sessionId, assessmentType), entry);
    }

    if (entry.actionType === LogActionType.ASSESSMENT_SCORE &&
      Object.prototype.hasOwnProperty.call(ASSESSMENT_LABELS, entry.data?.assessmentType)) {
      savedScores.set(
        recordKey(sessionId, entry.data.assessmentType),
        entry,
      );
    }
  });

  return Array.from(submissions.entries())
    .map(([key, submission]) => {
      const sessionId = submission.data.sessionId;
      const assessmentType = SUBMISSION_TYPES[submission.actionType];
      const scoreEntry = savedScores.get(key);
      const scores = Object.fromEntries(
        FUNCTION_ASSESSMENT_QUESTIONS.map(({ key: questionKey }) => [
          questionKey,
          normalizeScore(scoreEntry?.data?.scores?.[questionKey]),
        ]),
      );

      return {
        id: key,
        sessionId,
        assessmentType,
        assessmentLabel: ASSESSMENT_LABELS[assessmentType],
        functionExpression: submission.data.functionExpression || '',
        submittedAt: submission.timestamp,
        answers: Object.fromEntries(
          FUNCTION_ASSESSMENT_QUESTIONS.map(({ key: questionKey }) => [
            questionKey,
            typeof submission.data.assessment[questionKey] === 'string'
              ? submission.data.assessment[questionKey]
              : '',
          ]),
        ),
        scores,
        total: scoreEntry ? calculateAssessmentScore(scores) : null,
        maxScore: ASSESSMENT_SCORE_MAX,
        scoredAt: scoreEntry?.timestamp || null,
        rubricVersion: scoreEntry
          ? scoreEntry.data.rubricVersion || 1
          : null,
      };
    })
    .sort((a, b) => a.submittedAt - b.submittedAt || a.id.localeCompare(b.id));
}

export function getLatestAssessmentScores(logs) {
  const scores = new Map();
  getAssessmentScoringRecords(logs).forEach((record) => {
    if (record.total === null) return;
    const session = scores.get(record.sessionId) || {};
    session[record.assessmentType] = {
      scores: record.scores,
      total: record.total,
      maxScore: record.maxScore,
      scoredAt: record.scoredAt,
      rubricVersion: record.rubricVersion || ASSESSMENT_RUBRIC_VERSION,
    };
    scores.set(record.sessionId, session);
  });
  return scores;
}
</file>

<file path="src/services/DifficultyDetectionService.js">
// ============================================================
// src/services/DifficultyDetectionService.js
// Single Responsibility: detects difficulty patterns from logs.
// Open/Closed: new rules can be registered without touching existing ones.
// ============================================================

import { CTSkill, LogActionType } from '../core/types/enums';
import { getTimeInTool } from './logUtils';

const byFilled = (items = []) =>
  items.filter((i) => i.value && i.value.trim().length > 0).length;

/**
 * Each rule is independent. Thresholds are initial values
 * and are meant to be calibrated in a pilot study.
 */
const DETECTION_RULES = {
  [CTSkill.DECOMPOSITION]: {
    id: 'decomp-struggle',
    description: 'Struggle with problem decomposition',
    detect: (logs, toolState) => {
      const skillLogs = logs.filter((l) => l.skill === CTSkill.DECOMPOSITION);
      const count = (type) =>
        skillLogs.filter((l) => l.actionType === type).length;

      const editCount = count(LogActionType.EDIT);
      const addRemove =
        count(LogActionType.STEP_ADD) + count(LogActionType.STEP_REMOVE);
      const timeInTool = getTimeInTool(skillLogs);
      const stepsWithContent = byFilled(toolState.decomposition?.steps);

      const isChurning = addRemove > 4 && stepsWithContent <= 1;
      const isStalled = timeInTool > 120 && stepsWithContent === 0;
      const isRestarting = editCount > 8 && stepsWithContent <= 1;

      return isChurning || isStalled || isRestarting;
    },
  },

  [CTSkill.ABSTRACTION]: {
    id: 'abstract-struggle',
    description: 'Struggle with identifying relevant data',
    detect: (logs, toolState) => {
      const skillLogs = logs.filter((l) => l.skill === CTSkill.ABSTRACTION);
      const rows = toolState.abstraction?.rows || [];

      const incorrect = rows.filter(
        (r) =>
          r.userRelevant !== undefined && r.userRelevant !== r.actualRelevant,
      ).length;
      const timeInTool = getTimeInTool(skillLogs);

      const manyErrors = incorrect >= 3;
      const stalledNoProgress =
        rows.length > 0 &&
        timeInTool > 90 &&
        rows.every((r) => r.userRelevant === undefined);

      return manyErrors || stalledNoProgress;
    },
  },

  [CTSkill.ALGORITHMIC]: {
    id: 'algo-struggle',
    description: 'Struggle with building action sequence',
    detect: (logs, toolState) => {
      const skillLogs = logs.filter((l) => l.skill === CTSkill.ALGORITHMIC);
      const editCount = skillLogs.filter(
        (l) => l.actionType === LogActionType.EDIT,
      ).length;
      const filled = byFilled(toolState.algorithmic?.nodes);
      const timeInTool = getTimeInTool(skillLogs);

      const frequentEditsLowOutput = editCount > 10 && filled <= 1;
      const stalledEmpty = timeInTool > 120 && filled === 0;

      return frequentEditsLowOutput || stalledEmpty;
    },
  },
};

/**
 * Returns { detected, skill, ruleId, description }.
 * Rules are evaluated in registration order; first match wins.
 */
export function detectDifficulty(logs, toolState) {
  for (const [skill, rule] of Object.entries(DETECTION_RULES)) {
    if (rule.detect(logs, toolState)) {
      return {
        detected: true,
        skill,
        ruleId: rule.id,
        description: rule.description,
      };
    }
  }
  return { detected: false, skill: null, ruleId: null, description: null };
}

/**
 * Fallback used when a student explicitly asks for help but no rule fired:
 * picks the CT skill with the least visible progress in its tool.
 */
export function inferWeakestSkill(toolState) {
  const progress = {
    [CTSkill.DECOMPOSITION]: byFilled(toolState.decomposition?.steps),
    [CTSkill.ABSTRACTION]: (toolState.abstraction?.rows || []).filter(
      (r) => r.userRelevant !== undefined,
    ).length,
    [CTSkill.ALGORITHMIC]: byFilled(toolState.algorithmic?.nodes),
  };

  return Object.entries(progress).sort((a, b) => a[1] - b[1])[0][0];
}

/** Extension point — add or replace a rule without modifying existing ones. */
export function registerDetectionRule(skill, rule) {
  DETECTION_RULES[skill] = rule;
}

export function getRegisteredRules() {
  return Object.entries(DETECTION_RULES).map(([skill, rule]) => ({
    skill,
    id: rule.id,
    description: rule.description,
  }));
}
</file>


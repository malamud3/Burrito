            padding: 4px;
            opacity: 0.5;
            transition: var(--transition);
        }

        .remove-step:hover { opacity: 1; }

        /* ===== ABSTRACTION TABLE ===== */
        .abstraction-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        .abstraction-table th,
        .abstraction-table td {
            padding: 10px 14px;
            border: 1px solid var(--border);
            text-align: right;
        }

        .abstraction-table th {
            background: var(--surface3);
            color: var(--text2);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .abstraction-table td input {
            border: none;
            background: transparent;
            color: var(--text);
            width: 100%;
        }

        .abstraction-table td input:focus {
            box-shadow: none;
        }

        /* ===== FLOWCHART BUILDER ===== */
        .flow-builder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
        }

        .flow-node {
            background: var(--surface3);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 10px 20px;
            min-width: 200px;
            text-align: center;
            position: relative;
        }

        .flow-node input {
            text-align: center;
            border: none;
            background: transparent;
            color: var(--text);
            width: 100%;
            font-size: 0.9rem;
        }

        .flow-arrow {
            color: var(--text2);
            font-size: 1.2rem;
        }

        /* ===== HINT SYSTEM ===== */
        .hint-box {
            background: rgba(108,140,255,0.08);
            border: 1px solid rgba(108,140,255,0.25);
            border-radius: var(--radius);
            padding: 20px;
            margin: 16px 0;
            display: none;
        }

        .hint-box.visible { display: block; animation: fadeIn 0.5s ease; }

        .hint-box .hint-level {
            font-size: 0.75rem;
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 8px;
        }

        /* ===== ANALOG MISSION ===== */
        .analog-banner {
            background: linear-gradient(135deg, rgba(167,139,250,0.1), rgba(56,189,248,0.1));
            border: 1px solid rgba(167,139,250,0.3);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 20px;
            text-align: center;
        }

        .analog-banner h3 {
            color: var(--accent1);
            margin-bottom: 8px;
        }

        /* ===== EFFORT SCALE ===== */
        .effort-scale {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        .effort-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 2px solid var(--border);
            background: var(--surface2);
            color: var(--text2);
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .effort-btn:hover { border-color: var(--primary); color: var(--primary); }
        .effort-btn.selected {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .effort-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text2);
            margin-top: 4px;
        }

        /* ===== PROGRESS BAR ===== */
        .progress-bar {
            width: 100%;
            height: 6px;
            background: var(--surface3);
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent2));
            border-radius: 3px;
            transition: width 0.5s ease;
        }

        /* ===== TIMER ===== */
        .timer {
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            color: var(--text2);
            background: var(--surface3);
            padding: 4px 12px;
            border-radius: 20px;
        }

        /* ===== LOG PANEL (RESEARCHER) ===== */
        .log-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            max-height: 400px;
            overflow-y: auto;
            padding: 16px;
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            direction: ltr;
            text-align: left;
        }

        .log-entry {
            padding: 4px 0;
            border-bottom: 1px solid rgba(54,59,74,0.5);
            color: var(--text2);
        }

        .log-entry .log-time { color: var(--accent2); }
        .log-entry .log-action { color: var(--success); }
        .log-entry .log-data { color: var(--text); }

        /* ===== RESEARCHER DASHBOARD ===== */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: var(--surface2);
            border-radius: var(--radius-sm);
            padding: 20px;
            text-align: center;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text2);
            margin-top: 4px;
        }

        /* ===== LOGIN SCREEN ===== */
        .login-card {
            max-width: 450px;
            margin-top: 10vh;
        }

        .login-card h1 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 8px;
            color: var(--primary);
        }

        .login-card .subtitle {
            text-align: center;
            color: var(--text2);
            margin-bottom: 32px;
        }

        select {
            width: 100%;
            background: var(--surface3);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            color: var(--text);
            font-size: 0.95rem;
            font-family: inherit;
            appearance: none;
            cursor: pointer;
        }

        select:focus {
            outline: none;
            border-color: var(--primary);
        }

        /* ===== COMPLETION ===== */
        .completion-icon {
            font-size: 4rem;
            margin-bottom: 16px;
        }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(248,113,113,0.3); }
            50% { box-shadow: 0 0 0 8px rgba(248,113,113,0); }
        }

        .pulse { animation: pulse 2s infinite; }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .app-header { flex-direction: column; gap: 8px; }
            .header-info { flex-wrap: wrap; }
            .dashboard-grid { grid-template-columns: 1fr; }
            .effort-scale { justify-content: center; }
        }

        /* ===== NOTIFICATION ===== */
        .notification {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 24px;
            box-shadow: var(--shadow);
            z-index: 1000;
            transition: transform 0.4s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .notification.show { transform: translateX(-50%) translateY(0); }

        .notification-icon { font-size: 1.3rem; }

        /* ===== TABS ===== */
        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 20px;
            background: var(--surface2);
            border-radius: var(--radius-sm);
            padding: 4px;
        }

        .tab {
            padding: 10px 20px;
            border: none;
            background: transparent;
            color: var(--text2);
            font-size: 0.9rem;
            font-family: inherit;
            cursor: pointer;
            border-radius: 6px;
            transition: var(--transition);
            font-weight: 500;
        }

        .tab.active {
            background: var(--primary);
            color: #fff;
        }

        .tab:hover:not(.active) { color: var(--text); }

/* ===== APP SHELL (React) ===== */
.app-shell { min-height: 100vh; padding: 20px; }
.app-shell > .app-header { margin-bottom: 20px; border-radius: var(--radius); border: 1px solid var(--border); }

/* ===== DASHBOARD EXTRAS ===== */
.timeline-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.timeline-label { width: 160px; font-size: 0.85rem; color: var(--text2); flex-shrink: 0; }
.timeline-track { flex: 1; background: var(--surface3); border-radius: 6px; height: 22px; overflow: hidden; }
.timeline-fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--accent2)); border-radius: 6px; min-width: 2px; transition: width .4s ease; }
.timeline-value { width: 70px; font-size: 0.8rem; color: var(--text); font-family: 'Courier New', monospace; text-align: left; }
.detection-row { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
.detection-row:last-child { border-bottom: none; }
.summary-list { list-style: none; }
.summary-list li { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
.summary-list li span:first-child { color: var(--text2); }
.empty-state { text-align: center; color: var(--text2); padding: 32px 0; }

/* ===== QUIET, EDITORIAL LEARNING UI ===== */
:root {
    color-scheme: light;
    --bg: #eeece3;
    --surface: #f9f7f0;
    --surface2: #f4f1e8;
    --surface3: #ebe8de;
    --border: #ded9cb;
    --text: #302f2a;
    --text2: #68675f;
    --primary: #55745e;
    --primary-dim: #435e4b;
    --success: #55745e;
    --warning: #87643b;
    --danger: #a64f46;
    --accent1: #756682;
    --accent2: #547687;
    --accent3: #a36c4f;
    --radius: 18px;
    --radius-sm: 12px;
    --shadow: 0 8px 28px rgba(0, 0, 0, 0.045);
    --transition: 180ms ease;
}

body {
    background:
        radial-gradient(ellipse at 50% -18%, rgba(214, 222, 203, 0.62), transparent 48%),
        var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

button, input, textarea, select { font: inherit; }
button { -webkit-tap-highlight-color: transparent; }
h1, h2, h3, p { text-wrap: pretty; }

.app-shell { padding: 24px clamp(16px, 4vw, 48px) 48px; }
.container, .container-wide { padding-inline: 8px; }
.container { max-width: 760px; }
.container-wide { max-width: 1120px; }

.app-shell > .app-header {
    max-width: 1120px;
    margin: 0 auto 30px;
    padding: 16px 22px;
    border: 1px solid rgba(222, 217, 203, 0.9);
    border-radius: 14px;
    background: rgba(249, 247, 240, 0.9);
    box-shadow: 0 4px 18px rgba(71, 65, 48, 0.035);
}

.app-header h1 { color: var(--text); font-size: 1.12rem; letter-spacing: -0.02em; }
.header-info { gap: 10px; }
.badge {
    padding: 5px 11px;
    border: 1px solid transparent;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
}
.badge-adaptive { background: #e6ede3; color: #405e49; border-color: #d4dfd1; }
.badge-fixed { background: #f1e8d8; color: #755631; border-color: #e5d8c1; }
.badge-phase { background: #efede5; color: #5f5d55; border-color: #e2ded2; }
.badge-renato { background: #e6ede3; color: #405e49; border-color: #d4dfd1; }
.badge-classic { background: #f1e8d8; color: #755631; border-color: #e5d8c1; }
.timer {
    padding: 5px 10px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text2);
    font-variant-numeric: tabular-nums;
   font-feature-settings: "tnum";
}

.card, .ct-tool {
   border: 1px solid var(--border);
   border-radius: var(--radius);
   background: var(--surface);
   box-shadow: var(--shadow);
}
.card { padding: clamp(20px, 3vw, 30px); margin-bottom: 16px; }
.card-accent { border-inline-start: 3px solid #91a68d; }
.card h2 { font-size: clamp(1.16rem, 2.4vw, 1.35rem); line-height: 1.35; letter-spacing: -0.02em; }
.card h3, .card h4 { color: var(--text); font-size: 1.04rem; line-height: 1.4; }
.card p { line-height: 1.8; }
.card > p:last-child { margin-bottom: 0; }
.card > h2 + p { margin-top: 10px; }

.progress-bar {
    height: 5px;
    margin-bottom: 26px;
    background: #e2dfd4;
    border-radius: 99px;
}
.progress-fill {
    background: linear-gradient(90deg, #55745e, #8ba184);
    border-radius: 99px;
}

.problem-box {
    padding: clamp(22px, 4vw, 36px);
    margin: 0 0 16px;
    border: 1px solid #ded9cb;
    border-radius: var(--radius);
    background: linear-gradient(145deg, #faf8f2 0%, #f5f2e9 100%);
    box-shadow: var(--shadow);
}
.problem-box .problem-label {
    position: static;
    display: inline-flex;
    margin-bottom: 12px;
    padding: 4px 11px;
    background: #e6ede3;
    color: #405e49;
    border: 1px solid #d4dfd1;
}
.problem-box .problem-text {
    max-width: 68ch;
    margin: 0 auto;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.9;
    unicode-bidi: plaintext;
}
.problem-box .problem-question {
    max-width: 68ch;

.effort-btn {
    width: 46px;
    height: 46px;
    border: 1px solid #d5d0c4;
    background: #f8f6ef;
    color: #5c5a52;
}
.effort-btn:hover { border-color: #a7b9a1; background: #eef2e9; color: #405e49; }
.effort-btn.selected { border-color: var(--primary); background: var(--primary); color: #fff; }
.effort-labels { margin-top: 8px; }
.effort-labels span { max-width: 46%; line-height: 1.5; }
.effort-scale + .effort-labels { gap: 12px; }

.dashboard-grid { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
.stat-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #f9f7f0;
    text-align: right;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.025);
}
.stat-value { color: var(--primary); font-size: 1.8rem; font-variant-numeric: tabular-nums; }
.stat-label { color: var(--text2); }
.tabs { gap: 5px; border: 1px solid var(--border); border-radius: 12px; background: #eae8df; }
.tab { border-radius: 9px; color: #5c5a52; }
.tab.active { background: #f9f7f0; color: #405e49; box-shadow: 0 2px 6px rgba(71, 65, 48, 0.08); }
.tab:hover:not(.active) { color: var(--text); }
.log-panel { border-color: var(--border); border-radius: 12px; background: #f4f1e8; }
.log-entry { border-color: #e2ded3; }
.log-entry .log-time { color: #466879; }
.log-entry .log-action { color: var(--primary); }
.timeline-track { background: #e6e2d7; }
.timeline-fill { background: linear-gradient(90deg, #55745e, #8ba184); }
.detection-row, .summary-list li { border-color: var(--border); }
.detection-row { align-items: baseline; color: var(--text); }
.detection-row span:first-child { color: var(--text2); }
.summary-list li { gap: 18px; padding-block: 11px; }
.summary-list li strong { color: var(--text); text-align: left; }
.log-panel { color: #3f433d; }
.log-entry .log-action { font-weight: 600; }
.timeline-label { color: #5e6259; }

.login-card {
    max-width: 460px;
    margin: clamp(34px, 9vh, 88px) auto 0;
    padding: clamp(28px, 5vw, 42px);
}
.login-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
}
.login-brand h1 { color: var(--text); font-size: 1.8rem; letter-spacing: -0.04em; }
.login-mark {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid #d4dfd1;

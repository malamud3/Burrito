    activityPath: 'classic',
    functionExpression: 'x² / (x² − 6x + 8)',
  });
  expect(logs.some(({ actionType }) => actionType === 'learning_complete')).toBe(true);
  expect(Object.keys(transferSubmit.data.assessment)).toHaveLength(10);
});


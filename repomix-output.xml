.login-subtitle { margin: 0 0 28px; color: var(--text2); text-align: center; }
.login-field { margin-bottom: 16px; }
.login-path-picker {
    display: grid;
    gap: 10px;
    margin: 22px 0 16px;
    padding: 0;
